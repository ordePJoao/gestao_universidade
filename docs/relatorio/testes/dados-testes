        Professor profAna = new Professor("12345678901", "Ana Paula Rocha", "ana.rocha@ufu.br", "PROF-101", "FACOM");
        Professor profCarlos = new Professor("23456789012", "Carlos Eduardo Lima", "carlos.lima@ufu.br", "PROF-102", "FEELT");
        univ.adicionarProfessor(profAna);
        univ.adicionarProfessor(profCarlos);

        // 5 Alunos (herdam de Pessoa) - Turma T01 tera capacidade 3 para facilitar teste de turma cheia
        Aluno a1 = new Aluno("34567890123", "Lucas Mendes", "lucas.mendes@ufu.br", "20261001", cursoSistemas);
        Aluno a2 = new Aluno("45678901234", "Mariana Souza", "mariana.souza@ufu.br", "20261002", cursoSistemas);
        Aluno a3 = new Aluno("56789012345", "Rafael Oliveira", "rafael.oliveira@ufu.br", "20261003", cursoSistemas);
        Aluno a4 = new Aluno("67890123456", "Beatriz Costa", "beatriz.costa@ufu.br", "20261004", cursoEngenharia);
        Aluno a5 = new Aluno("78901234567", "Pedro Henrique", "pedro.henrique@ufu.br", "20261005", cursoEngenharia);
        univ.adicionarAluno(a1);
        univ.adicionarAluno(a2);
        univ.adicionarAluno(a3);
