    public static class Avaliacao implements Serializable {
        private static final long serialVersionUID = 1L;
        private String descricao;
        private double nota;

        public Avaliacao(String descricao, double nota) throws NotaInvalidaException {
            this.descricao = descricao;
            setNota(nota);
        }

        public String getDescricao() { return descricao; }
        public void setDescricao(String descricao) { this.descricao = descricao; }

        public double getNota() { return nota; }
        public void setNota(double nota) throws NotaInvalidaException {
            if (Double.isNaN(nota) || nota < 0.0 || nota > 10.0) {
                throw new NotaInvalidaException("Nota invalida: " + nota + " (deve estar entre 0.0 e 10.0).");
            }
            this.nota = nota;
        }
    }

    public static class Matricula implements Serializable {
        private static final long serialVersionUID = 1L;
        private Aluno aluno;
        private Turma turma;
        private final List<Avaliacao> avaliacoes = new ArrayList<>();

        public Matricula(Aluno aluno, Turma turma) {
            this.aluno = aluno;
            this.turma = turma;
        }

        public Aluno getAluno() { return aluno; }
        public Turma getTurma() { return turma; }
        public List<Avaliacao> getAvaliacoes() { return Collections.unmodifiableList(avaliacoes); }

        public void adicionarAvaliacao(String descricao, double nota) throws NotaInvalidaException {
            avaliacoes.add(new Avaliacao(descricao, nota));
        }

        public double calcularMedia() {
            if (avaliacoes.isEmpty()) {
                return 0.0;
            }
            double soma = 0.0;
            for (Avaliacao av : avaliacoes) {
                soma += av.getNota();
            }
            return soma / avaliacoes.size();
        }

        public String getSituacao() {
            return calcularMedia() >= 6.0 ? "Aprovado" : "Reprovado";
        }
    }

    public static class Turma implements Exibivel, Serializable {
        private static final long serialVersionUID = 1L;
        private String codigo;
        private String semestre;
        private int capacidadeMaxima;
        private Disciplina disciplina;
        private Professor professor;
        private final List<Matricula> matriculas = new ArrayList<>();

        public Turma(String codigo, String semestre, int capacidadeMaxima, Disciplina disciplina, Professor professor) {
            this.codigo = codigo;
            this.semestre = semestre;
            this.capacidadeMaxima = capacidadeMaxima;
            this.disciplina = disciplina;
            this.professor = professor;
        }

        public String getCodigo() { return codigo; }
        public String getSemestre() { return semestre; }
        public int getCapacidadeMaxima() { return capacidadeMaxima; }
        public Disciplina getDisciplina() { return disciplina; }
        public Professor getProfessor() { return professor; }
        public List<Matricula> getMatriculas() { return Collections.unmodifiableList(matriculas); }

        public void matricular(Aluno aluno) throws TurmaCheiaException, MatriculaDuplicadaException {
            for (Matricula m : matriculas) {
                if (m.getAluno().getMatricula().equals(aluno.getMatricula())) {
                    throw new MatriculaDuplicadaException(
                            "Aluno " + aluno.getMatricula() + " ja matriculado na turma " + codigo + "."
                    );
                }
            }
            if (matriculas.size() >= capacidadeMaxima) {
                throw new TurmaCheiaException(
                        "Turma " + codigo + " atingiu a capacidade maxima de " + capacidadeMaxima + " vagas."
                );
            }
            matriculas.add(new Matricula(aluno, this));
        }

        public Matricula buscarMatricula(String matriculaAluno) throws AlunoNaoEncontradoException {
            for (Matricula m : matriculas) {
                if (m.getAluno().getMatricula().equals(matriculaAluno)) {
                    return m;
                }
            }
            throw new AlunoNaoEncontradoException(
                    "Matricula " + matriculaAluno + " nao encontrada na turma " + codigo + "."
            );
        }

        @Override
        public String exibirDados() {
            return String.format("Turma[%s] %s (%d/%d vagas)",
                    codigo, disciplina != null ? disciplina.getNome() : "", matriculas.size(), capacidadeMaxima);
        }
    }

    public static class Universidade implements Serializable {
        private static final long serialVersionUID = 1L;
        private String nome;
        private final List<Curso> cursos = new ArrayList<>();
        private final List<Disciplina> disciplinas = new ArrayList<>();
        private final List<Professor> professores = new ArrayList<>();
        private final List<Aluno> alunos = new ArrayList<>();
        private final List<Turma> turmas = new ArrayList<>();

        public Universidade(String nome) {
            this.nome = nome;
        }

        public String getNome() { return nome; }
        public List<Curso> getCursos() { return Collections.unmodifiableList(cursos); }
        public List<Disciplina> getDisciplinas() { return Collections.unmodifiableList(disciplinas); }
        public List<Professor> getProfessores() { return Collections.unmodifiableList(professores); }
        public List<Aluno> getAlunos() { return Collections.unmodifiableList(alunos); }
        public List<Turma> getTurmas() { return Collections.unmodifiableList(turmas); }

        public void adicionarCurso(Curso c) { cursos.add(c); }
        public void adicionarDisciplina(Disciplina d) { disciplinas.add(d); }
        public void adicionarProfessor(Professor p) { professores.add(p); }
        public void adicionarAluno(Aluno a) { alunos.add(a); }
        public void adicionarTurma(Turma t) { turmas.add(t); }

        public Aluno buscarAlunoPorMatricula(String matricula) throws AlunoNaoEncontradoException {
            for (Aluno a : alunos) {
                if (a.getMatricula().equals(matricula)) {
                    return a;
                }
            }
            throw new AlunoNaoEncontradoException("Aluno com matricula '" + matricula + "' nao encontrado.");
        }

        public Turma buscarTurmaPorCodigo(String codigo) {
            for (Turma t : turmas) {
                if (t.getCodigo().equals(codigo)) {
                    return t;
                }
            }
            throw new IllegalArgumentException("Turma com codigo '" + codigo + "' nao encontrada.");
        }
    }
