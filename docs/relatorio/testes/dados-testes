        Curso cursoEngenharia = new Curso("ENG", "Engenharia de Computacao", "FEELT");
        univ.adicionarCurso(cursoSistemas);
        univ.adicionarCurso(cursoEngenharia);

        // 3 Disciplinas
        Disciplina poo = new Disciplina("POO01", "Programacao Orientada a Objetos", 60, cursoSistemas);
        Disciplina bd = new Disciplina("BD002", "Banco de Dados Relacionais", 60, cursoSistemas);
