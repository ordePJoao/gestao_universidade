    public interface Exibivel extends Serializable {
        String exibirDados();
    }

    public static abstract class Pessoa implements Exibivel, Serializable {
        private static final long serialVersionUID = 1L;
        private String cpf;
        private String nome;
        private String email;

        protected Pessoa(String cpf, String nome, String email) {
            setCpf(cpf);
            this.nome = nome;
            this.email = email;
        }

        public String getCpf() { return cpf; }
        public void setCpf(String cpf) {
            String digitos = cpf == null ? "" : cpf.replaceAll("\\D", "");
            if (digitos.length() != 11) {
                throw new CpfInvalidoException("CPF invalido: " + cpf + " (deve conter 11 digitos).");
            }
            this.cpf = digitos;
        }

        public String getNome() { return nome; }
        public void setNome(String nome) { this.nome = nome; }

        public String getEmail() { return email; }
        public void setEmail(String email) { this.email = email; }

        public abstract String getIdent();
    }

    public static class Aluno extends Pessoa {
        private static final long serialVersionUID = 1L;
        private String matricula;
        private Curso curso;

        public Aluno(String cpf, String nome, String email, String matricula, Curso curso) {
            super(cpf, nome, email);
            this.matricula = matricula;
            this.curso = curso;
        }

        public String getMatricula() { return matricula; }
        public void setMatricula(String matricula) { this.matricula = matricula; }

        public Curso getCurso() { return curso; }
        public void setCurso(Curso curso) { this.curso = curso; }

        @Override
        public String getIdent() { return matricula; }

        @Override
        public String exibirDados() {
            return String.format("Aluno[%s] %s - Curso: %s", matricula, getNome(), curso != null ? curso.getNome() : "Sem curso");
        }
    }

