    public static void executarFluxoAcademico(Universidade univ)
            throws TurmaCheiaException, MatriculaDuplicadaException, NotaInvalidaException, AlunoNaoEncontradoException {

        Turma turmaPoo = univ.buscarTurmaPorCodigo("T01-POO");
        Aluno a1 = univ.buscarAlunoPorMatricula("20261001");
        Aluno a2 = univ.buscarAlunoPorMatricula("20261002");

        // Matricula de alunos na turma
        turmaPoo.matricular(a1);
        turmaPoo.matricular(a2);

        // Lancamento de notas e calculo de media/situacao
        Matricula m1 = turmaPoo.buscarMatricula(a1.getMatricula());
        m1.adicionarAvaliacao("P1", 8.5);
        m1.adicionarAvaliacao("P2", 9.0);
        m1.adicionarAvaliacao("Trabalho", 8.0);

        Matricula m2 = turmaPoo.buscarMatricula(a2.getMatricula());
        m2.adicionarAvaliacao("P1", 4.5);
        m2.adicionarAvaliacao("P2", 5.0);
        m2.adicionarAvaliacao("Trabalho", 4.0);

        System.out.printf(Locale.US,
                "Fluxo POO -> %s: media=%.2f (%s) | %s: media=%.2f (%s)%n",
                a1.getNome(), m1.calcularMedia(), m1.getSituacao(),
                a2.getNome(), m2.calcularMedia(), m2.getSituacao()
        );
    }

    public static void testarExcecoesObrigatorias(Universidade univ) {
        Turma turmaPoo = univ.buscarTurmaPorCodigo("T01-POO");

        // 1. Matricula duplicada
        try {
            Aluno a1 = univ.buscarAlunoPorMatricula("20261001");
            turmaPoo.matricular(a1);
        } catch (MatriculaDuplicadaException e) {
            System.out.println("[OK] MatriculaDuplicadaException: " + e.getMessage());
        } catch (TurmaCheiaException e) {
            System.out.println("[INFO] Turma ja atingiu capacidade antes da duplicidade: " + e.getMessage());
        }

        // 2. Turma cheia (capacidade de T01-POO = 3; ja ha 2 alunos matriculados)
        try {
            Aluno a3 = univ.buscarAlunoPorMatricula("20261003");
            Aluno a4 = univ.buscarAlunoPorMatricula("20261004");
            turmaPoo.matricular(a3); // 3a vaga ocupada
            turmaPoo.matricular(a4); // deve lancar TurmaCheiaException
        } catch (TurmaCheiaException | MatriculaDuplicadaException e) {
            System.out.println("[OK] TurmaCheiaException: " + e.getMessage());
        }

        // 3. Nota invalida (fora do intervalo 0.0 a 10.0)
        try {
            Matricula m1 = turmaPoo.buscarMatricula("20261001");
            m1.adicionarAvaliacao("Sub", 11.5);
        } catch (NotaInvalidaException e) {
            System.out.println("[OK] NotaInvalidaException: " + e.getMessage());
        }

        // 4. CPF invalido
        try {
            new Aluno("123", "CPF Curto", "cpf@ufu.br", "20269999", univ.getCursos().get(0));
        } catch (CpfInvalidoException e) {
            System.out.println("[OK] CpfInvalidoException: " + e.getMessage());
        }

        // 5. Aluno nao encontrado
        try {
            univ.buscarAlunoPorMatricula("MAT-INEXISTENTE");
        } catch (AlunoNaoEncontradoException e) {
            System.out.println("[OK] AlunoNaoEncontradoException: " + e.getMessage());
        }
    }

    public static void salvarUniversidade(Universidade univ, Path arquivo) throws IOException {
        try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(arquivo.toFile()))) {
            oos.writeObject(univ);
        }
    }

    public static Universidade carregarOuCriarUniversidade(Path arquivo) {
        File file = arquivo.toFile();
        if (!file.exists()) {
            return new Universidade("Universidade Federal de Uberlandia");
        }
        try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(file))) {
            return (Universidade) ois.readObject();
        } catch (IOException | ClassNotFoundException e) {
            throw new IllegalStateException("Erro ao carregar dados persistidos: " + e.getMessage(), e);
        }
    }

    public static void validarPersistencia(Universidade univ) {
        System.out.printf(Locale.US,
                "Pos-reabertura -> Cursos: %d | Disciplinas: %d | Professores: %d | Alunos: %d | Turmas: %d%n",
                univ.getCursos().size(),
                univ.getDisciplinas().size(),
                univ.getProfessores().size(),
                univ.getAlunos().size(),
                univ.getTurmas().size()
        );
        Turma t = univ.buscarTurmaPorCodigo("T01-POO");
        System.out.println("Matriculas preservadas em T01-POO: " + t.getMatriculas().size());
        for (Matricula m : t.getMatriculas()) {
            System.out.printf(Locale.US, "  - %s (%s): media=%.2f -> %s%n",
                    m.getAluno().getNome(),
                    m.getAluno().getMatricula(),
                    m.calcularMedia(),
                    m.getSituacao()
            );
        }
    }

