/**
 * Arquivo único de preparação de dados, teste de fluxo e validação de exceções
 * para o projeto gestao_universidade (Java 17, Maven, javax.swing, java.io).
 *
 * Critérios cobertos:
 * - Dados de exemplo: 2 cursos, 3 disciplinas, 2 professores, 5 alunos, 2 turmas
 * - Fluxo: curso, disciplina, turma, aluno, matrícula, notas, média e situação
 * - Exceções: turma cheia, matrícula duplicada, nota inválida, CPF inválido, aluno não encontrado
 * - Persistência: salvar em data/universidade.dat e reabrir mantendo os dados
 */
public class DemonstracaoCompleta {

    private static final Path ARQUIVO_DADOS = Paths.get("data", "universidade.dat");

    public static void main(String[] args) {
        System.out.println("=== INICIANDO DEMONSTRACAO: gestao_universidade ===");

        try {
            // 1. Garante diretorio data/ e limpa execucao anterior para teste limpo
            Files.createDirectories(ARQUIVO_DADOS.getParent());
            Files.deleteIfExists(ARQUIVO_DADOS);

            // Primeira execucao sem arquivo -> Universidade vazia
            Universidade univ = carregarOuCriarUniversidade(ARQUIVO_DADOS);
            System.out.println("Primeira execucao -> Cursos iniciais: " + univ.getCursos().size());

            // 2. Carga dos dados de exemplo (2 cursos, 3 disciplinas, 2 professores, 5 alunos, 2 turmas)
            popularDadosDemonstracao(univ);

            // 3. Execucao do fluxo completo (curso, disciplina, turma, aluno, matricula, notas, media, situacao)
            executarFluxoAcademico(univ);

            // 4. Teste obrigatorio das 5 excecoes customizadas
            testarExcecoesObrigatorias(univ);

            // 5. Persistencia em data/universidade.dat
            salvarUniversidade(univ, ARQUIVO_DADOS);
            System.out.println("Estado salvo em: " + ARQUIVO_DADOS.toAbsolutePath());

            // 6. Fechar e reabrir o sistema -> validar manutencao dos dados
            Universidade univReaberta = carregarOuCriarUniversidade(ARQUIVO_DADOS);
            validarPersistencia(univReaberta);

            System.out.println("=== DEMONSTRACAO CONCLUIDA COM SUCESSO ===");
        } catch (Exception e) {
            System.err.println("Falha durante a demonstracao: " + e.getMessage());
            e.printStackTrace();
        }
    }

    public static void popularDadosDemonstracao(Universidade univ) {
